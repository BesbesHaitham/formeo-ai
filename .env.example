# Only public client configuration belongs in VITE_ variables.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8081

# Firebase public Web API key (Project settings > General > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Private Gemini key, consumed only by the local Vite server middleware.
GEMINI_API_KEY=

# Model with a documented free tier. Keep the project on the Free tier in AI Studio.
GEMINI_MODEL=gemini-3.5-flash
