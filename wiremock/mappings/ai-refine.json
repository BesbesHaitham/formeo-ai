{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/ai/generate",
    "bodyPatterns": [{ "matchesJsonPath": "$.current" }]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "transformers": ["response-template"],
    "body": "{\"form\": {{{jsonPath request.body '$.current'}}} }"
  }
}
